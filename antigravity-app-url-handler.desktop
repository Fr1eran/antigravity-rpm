[Desktop Entry]
Name=Antigravity - URL Handler
Comment=Google Antigravity Desktop App URL Handler
GenericName=AI Agent Platform
Exec=/usr/bin/antigravity-app --open-url %U
Icon=antigravity-app
Type=Application
NoDisplay=true
StartupNotify=true
Categories=Development;Utility;
MimeType=x-scheme-handler/antigravity;
Keywords=antigravity;agent;gemini;
